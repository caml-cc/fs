# Port the server will listen on
PORT=5100

# API key (preferably a 24 character random string)
API_KEY=abc123

# Maximum GB of space allowed to be taken up by file uploads
MAX_STORAGE=10

# Maximum size of a single upload request in GB (decimals allowed, optional, defaults to 1)
# Larger files are rejected with 413 unless uploaded in fragments (cc-store does this automatically)
MAX_UPLOAD=1

# Upload delettion period (in seconds)
KEEP=86400 # 1 day

# Directory where uploaded files are stored (optional, defaults to ./internal/uploads)
UPLOAD_DIR=./internal/uploads
